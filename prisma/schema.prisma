// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id               String    @id @default(cuid())
  domain           String    @unique // e.g. mega-bundle.myshopify.com
  carrierServiceId String? // gid://shopify/DeliveryCarrierService/...
  currency         String? // shop's base currency, e.g. INR
  installedAt      DateTime  @default(now())
  uninstalledAt    DateTime? // null = currently installed
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  productsSyncedAt DateTime? // last full product sync (null = never synced)
  settings         ShopSettings?
  rateLogs         RateLog[]
  rules            Rule[]
  postcodeLists    PostcodeList[]
  zones            Zone[]
  productSnapshots ProductSnapshot[]
}

model ShopSettings {
  id                  String   @id @default(cuid())
  shopId              String   @unique
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  fallbackEnabled     Boolean  @default(false)
  fallbackPrice       Int      @default(0) // subunits, e.g. 9900 = 99.00
  fallbackName        Json     @default("{\"en\":\"Standard Shipping\",\"fr\":\"Livraison standard\",\"de\":\"Standardversand\"}") // { en, fr, de }
  fallbackDescription Json? // { en, fr, de }
  combineStrategy     CombineStrategy @default(SUM) // when several rates share a name
  updatedAt           DateTime @updatedAt
}

model RateLog {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  currency    String
  locale      String?
  destination Json // country, province, city, postal_code (no name or street)
  items       Json // [{ name, sku, quantity, grams, price, product_id, variant_id }]
  rates       Json // what we returned
  outcome     String // "rates" | "fallback" | "none" | "error"
  testMode    Boolean
  durationMs  Int
  error       String?

  @@index([shopId, createdAt])
}

// ---------------------------------------------------------------------------
// Rules engine (phase 2). All money is in subunits (paise/cents), weight in
// grams, quantities as whole units, percentages in basis points (500 = 5%).
// ---------------------------------------------------------------------------

enum RuleStatus {
  ACTIVE
  INACTIVE
}

enum RuleMatch {
  ALL // every condition must match
  ANY // at least one condition matches
  NONE // no condition matches
}

enum ConditionSubject {
  CART
  PRODUCT
  ADDRESS
}

enum ConditionOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  GREATER_OR_EQUAL
  LESS_THAN
  LESS_OR_EQUAL
  CONTAINS
  NOT_CONTAINS
  IN // value is a list
  NOT_IN
  IN_POSTCODE_LIST
  NOT_IN_POSTCODE_LIST
}

enum ProductQuantifier {
  ANY // at least one product in the cart matches
  ALL // every product matches
  NONE // no product matches
}

enum RateMode {
  FLAT // one fixed price
  BANDS // price table by basis (from / to / price)
  INCREMENTAL // base price + price per step of basis
  PERCENT // percentage of cart subtotal
}

enum RateBasis {
  WEIGHT // grams
  QUANTITY // items
  SUBTOTAL // subunits
}

enum AdjustmentKind {
  HANDLING_FEE // added on top (fixed or percent)
  MIN_PRICE // never charge less than value
  MAX_PRICE // never charge more than value
  ROUND_TO // round up to the nearest value (e.g. 100 = nearest 1.00)
  FREE_OVER // free when cart subtotal >= value
}

enum AdjustmentType {
  FIXED // value in subunits
  PERCENT // value in basis points
}

enum CombineStrategy {
  SUM
  HIGHEST
  LOWEST
}

/// The "when": a set of conditions; its rates apply when they match.
model Rule {
  id          String      @id @default(cuid())
  shopId      String
  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  status      RuleStatus  @default(ACTIVE)
  priority    Int         @default(0) // lower runs first
  match       RuleMatch   @default(ALL)
  exclusive   Boolean     @default(false) // when it matches, skip lower-priority rules
  startsAt    DateTime? // optional schedule
  endsAt      DateTime?
  templateKey String? // which template created it, if any
  conditions  Condition[]
  rates       Rate[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([shopId, status, priority])
}

/// One line of a rule, e.g. CART weight LESS_THAN 2000.
model Condition {
  id             String             @id @default(cuid())
  ruleId         String
  rule           Rule               @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  subject        ConditionSubject
  field          String // cart: subtotal | quantity | weight; product: tag | type | vendor | sku | collection; address: country | province | postcode
  operator       ConditionOperator
  value          Json? // number, string or list of strings
  quantifier     ProductQuantifier? // product conditions only
  postcodeListId String?
  postcodeList   PostcodeList?      @relation(fields: [postcodeListId], references: [id], onDelete: SetNull)
  sortOrder      Int                @default(0)

  @@index([ruleId])
}

/// The "what to charge" for one of our zones.
model Rate {
  id              String           @id @default(cuid())
  ruleId          String
  rule            Rule             @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  zoneId          String
  zone            Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  preset          String? // standard | express | free | economy | next_day (translated in code)
  name            String? // custom name, shown as typed when there is no preset
  description     String?
  minDeliveryDays Int?
  maxDeliveryDays Int?
  mode            RateMode         @default(FLAT)
  basis           RateBasis? // required for BANDS and INCREMENTAL
  price           Int? // FLAT price, or INCREMENTAL base price
  stepSize        Int? // INCREMENTAL: per this many basis units
  stepPrice       Int? // INCREMENTAL: price per step
  percentBps      Int? // PERCENT: basis points of subtotal
  combineTag      String? // for tag-based combining (v2)
  sortOrder       Int              @default(0)
  bands           RateBand[]
  adjustments     RateAdjustment[]

  @@index([ruleId])
  @@index([zoneId])
}

/// One row of a rate's price table: from <= basis < to (to = null means no limit).
model RateBand {
  id        String @id @default(cuid())
  rateId    String
  rate      Rate   @relation(fields: [rateId], references: [id], onDelete: Cascade)
  from      Int
  to        Int?
  price     Int
  sortOrder Int    @default(0)

  @@index([rateId])
}

/// Extras applied after the base price, in sortOrder.
model RateAdjustment {
  id        String         @id @default(cuid())
  rateId    String
  rate      Rate           @relation(fields: [rateId], references: [id], onDelete: Cascade)
  kind      AdjustmentKind
  type      AdjustmentType @default(FIXED)
  value     Int
  sortOrder Int            @default(0)

  @@index([rateId])
}

/// Reusable postcodes: "560078" (exact), "5600*" (prefix), "560001-560099" (range).
model PostcodeList {
  id         String      @id @default(cuid())
  shopId     String
  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name       String
  entries    String[]
  conditions Condition[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([shopId])
}

/// Our own shipping zones (merchant-only names; customers never see them).
/// regions: [{ "country": "IN", "provinces": null }, { "country": "US", "provinces": ["CA", "NY"] }]
/// provinces null = whole country. Pre-filled from Shopify's General profile on install.
model Zone {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  restOfWorld   Boolean  @default(false)
  regions       Json     @default("[]")
  shopifyZoneId String? // set when imported from Shopify
  sortOrder     Int      @default(0)
  rates         Rate[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shopId])
}

/// A copy of the product fields checkout needs but Shopify doesn't send in the rate
/// request (tags, type, collections). Shopify is the source of truth; rows can be
/// re-synced at any time. Product and collection ids fit in a JS number (< 2^53).
model ProductSnapshot {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId     BigInt // Shopify product id, as sent in the rate request
  tags          String[] // lowercased and trimmed, for matching
  productType   String   @default("")
  vendor        String   @default("")
  collectionIds BigInt[] // Shopify collection ids
  updatedAt     DateTime @updatedAt

  @@unique([shopId, productId])
}
